<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0">
<meta name="theme-color" content="#4a0e1f">
<meta name="robots" content="noindex,nofollow">
<title>Le Marathon Du Médoc 26 — Mobile</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Mono:wght@400;500&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,800;1,9..144,400&display=swap" rel="stylesheet">
<style>
  :root{
    --wine: #4a0e1f;
    --wine-deep: #2d0812;
    --wine-light: #6b1a2e;
    --bordeaux: #722f37;
    --cream: #f4ead5;
    --cream-warm: #ede0c1;
    --gold: #c9a961;
    --gold-bright: #e6c87d;
    --ink: #1a0a0e;
    --paper: #faf3e0;
    --moss: #5a6b3f;
    --rust: #a84e2e;
  }

  *{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}

  html, body{
    background: var(--paper);
    color: var(--ink);
    font-family: 'Cormorant Garamond', serif;
    font-size: 16px;
    line-height: 1.45;
    overflow-x: hidden;
  }

  body{
    background-image:
      radial-gradient(ellipse at top, rgba(74,14,31,0.05), transparent 60%),
      radial-gradient(ellipse at bottom, rgba(201,169,97,0.08), transparent 60%);
    min-height: 100vh;
    padding-bottom: 80px;
  }

  body::before{
    content:'';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.5'/%3E%3C/svg%3E");
    opacity: 0.05;
    pointer-events: none;
    z-index: 1;
    mix-blend-mode: multiply;
  }

  .app{
    position: relative;
    z-index: 2;
    max-width: 440px;
    margin: 0 auto;
  }

  .header{
    padding: 20px 20px 16px;
    text-align: center;
    border-bottom: 1px solid var(--wine);
    position: relative;
  }
  .crest{
    width: 43px;
    height: 43px;
    border: 1.5px solid var(--wine);
    border-radius: 50%;
    margin: 0 auto 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    background: var(--paper);
  }
  .crest::before{
    content:'';
    position: absolute;
    inset: 3px;
    border: 1px solid var(--wine);
    border-radius: 50%;
  }
  .crest svg{ width: 22px; height: 22px; }
  .header h1{
    font-family: 'Fraunces', serif;
    font-weight: 800;
    font-style: italic;
    font-size: 38px;
    line-height: 1;
    color: var(--wine);
    letter-spacing: -0.02em;
  }
  .header .sub{
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--wine-light);
    margin-top: 8px;
  }

  .countdown-card{
    margin: 16px 16px 0;
    background: var(--wine);
    color: var(--cream);
    padding: 16px 20px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }
  .countdown-card::before{
    content:'';
    position: absolute;
    inset: 4px;
    border: 1px solid rgba(201,169,97,0.3);
    pointer-events: none;
    border-radius: 2px;
  }
  .countdown-card .label{
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-bright);
    line-height: 1.4;
  }
  .countdown-card .label .date{
    color: var(--cream);
    opacity: 0.7;
    font-size: 10px;
    letter-spacing: 0.15em;
    margin-top: 4px;
    display: block;
  }
  .countdown-card .num{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 44px;
    font-weight: 800;
    color: var(--gold-bright);
    line-height: 1;
    letter-spacing: -0.03em;
    position: relative;
    z-index: 1;
  }
  .countdown-card .num small{
    font-size: 11px;
    font-style: normal;
    font-family: 'DM Mono', monospace;
    color: var(--cream);
    opacity: 0.7;
    letter-spacing: 0.15em;
    display: block;
    margin-top: 2px;
  }

  .newsflash{
    margin-top: 16px;
    background: var(--wine-deep);
    color: var(--cream);
    overflow: hidden;
    border-top: 1px solid var(--gold);
    border-bottom: 1px solid var(--gold);
  }
  .nf-track{
    display: inline-block;
    white-space: nowrap;
    animation: nf-tick 60s linear infinite;
    padding: 10px 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 14px;
    font-style: italic;
  }
  .nf-track span{ margin: 0 12px; }
  .nf-track b{
    color: var(--gold-bright);
    font-style: normal;
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.15em;
    margin-right: 4px;
  }
  @keyframes nf-tick{
    from{ transform: translateX(0); }
    to{ transform: translateX(-50%); }
  }

  .tabs{
    position: sticky;
    top: 0;
    background: var(--paper);
    border-bottom: 1px solid var(--wine);
    z-index: 50;
    display: flex;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar{ display: none; }
  .tab{
    flex-shrink: 0;
    padding: 14px 16px 12px;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--wine-light);
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
  }
  .tab.active{
    color: var(--wine);
    border-bottom-color: var(--wine);
  }

  .content{ padding: 20px 16px 0; }
  .panel{ display: none; }
  .panel.active{ display: block; animation: fadeIn 0.25s ease; }
  @keyframes fadeIn{
    from{ opacity: 0; transform: translateY(4px); }
    to{ opacity: 1; transform: translateY(0); }
  }

  .sec-head{
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 1px dashed var(--wine);
  }
  .sec-head .roman{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 16px;
    color: var(--gold);
    font-weight: 600;
  }
  .sec-head h2{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 600;
    font-size: 22px;
    color: var(--wine);
    letter-spacing: -0.01em;
  }
  .sec-head .meta{
    margin-left: auto;
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--wine-light);
  }

  .squad-card{
    background: linear-gradient(135deg, var(--wine) 0%, var(--wine-deep) 100%);
    color: var(--cream);
    padding: 18px;
    margin-bottom: 16px;
    border-radius: 4px;
    position: relative;
  }
  .squad-card::before{
    content:'';
    position: absolute;
    inset: 4px;
    border: 1px solid rgba(201,169,97,0.25);
    pointer-events: none;
    border-radius: 2px;
  }
  .squad-card .title{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 18px;
    color: var(--gold-bright);
    margin-bottom: 4px;
  }
  .squad-card .sub{
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--cream);
    opacity: 0.7;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .squad-grid{
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 10px;
  }
  .squad-grid .stat{
    border-left: 1px solid rgba(201,169,97,0.3);
    padding-left: 10px;
  }
  .squad-grid .stat .v{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 22px;
    font-weight: 700;
    color: var(--gold-bright);
    line-height: 1;
  }
  .squad-grid .stat .v .u{
    font-size: 11px;
    color: var(--cream);
    opacity: 0.7;
    margin-left: 2px;
    font-weight: 400;
  }
  .squad-grid .stat .l{
    font-family: 'DM Mono', monospace;
    font-size: 8px;
    letter-spacing: 0.12em;
    color: var(--cream);
    opacity: 0.7;
    text-transform: uppercase;
    margin-top: 4px;
  }

  .big-card{
    background: var(--cream);
    border: 1px solid rgba(74,14,31,0.25);
    padding: 16px 18px;
    margin-bottom: 12px;
    border-radius: 4px;
    position: relative;
  }
  .big-card .lbl{
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--wine-light);
    margin-bottom: 6px;
  }
  .big-card .v{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 28px;
    font-weight: 800;
    color: var(--wine);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .big-card .v .unit{
    font-size: 13px;
    font-weight: 400;
    font-style: italic;
    color: var(--wine-light);
    margin-left: 3px;
  }
  .big-card .delta{
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    margin-top: 4px;
    letter-spacing: 0.05em;
  }
  .big-card .delta.up{ color: var(--moss); }
  .big-card .delta.down{ color: var(--rust); }

  .big-card.groom{
    background: var(--wine);
    color: var(--cream);
    border-color: var(--gold);
  }
  .big-card.groom .lbl{ color: var(--gold-bright); }
  .big-card.groom .v{ color: var(--gold-bright); }
  .big-card.groom .v .unit{ color: var(--cream); opacity: 0.7; }
  .big-card.groom .meta{
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--cream);
    opacity: 0.85;
    margin-top: 6px;
  }

  .stat-row{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 16px;
  }
  .stat-row .big-card{ margin-bottom: 0; }

  .runner-card{
    background: var(--cream);
    border: 1px solid rgba(74,14,31,0.2);
    padding: 14px 14px 12px;
    margin-bottom: 10px;
    border-radius: 4px;
    position: relative;
    display: grid;
    grid-template-columns: 36px 1fr auto;
    gap: 12px;
    align-items: center;
  }
  .runner-card.top{
    background: var(--wine);
    color: var(--cream);
    border-color: var(--gold);
  }
  .runner-card .rank{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 26px;
    font-weight: 800;
    color: var(--wine);
    text-align: center;
    line-height: 1;
  }
  .runner-card.top .rank{ color: var(--gold-bright); }

  .runner-card .info .name{
    font-family: 'Fraunces', serif;
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.1;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }
  .runner-card.top .info .name{ color: var(--cream); }
  .runner-card .info .badge{
    font-family: 'DM Mono', monospace;
    font-size: 8px;
    letter-spacing: 0.15em;
    color: var(--gold);
    text-transform: uppercase;
    padding: 2px 6px;
    border: 1px solid var(--gold);
    border-radius: 2px;
    line-height: 1;
  }
  .runner-card.top .info .badge{ color: var(--gold-bright); border-color: var(--gold-bright); }
  .runner-card .info .badge.rust{ color: var(--rust); border-color: var(--rust); }
  .runner-card .info .meta{
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--wine-light);
    margin-top: 4px;
  }
  .runner-card.top .info .meta{ color: var(--cream); opacity: 0.75; }

  .runner-card .stat{ text-align: right; }
  .runner-card .stat .v{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 18px;
    font-weight: 700;
    color: var(--wine);
    line-height: 1;
  }
  .runner-card.top .stat .v{ color: var(--gold-bright); }
  .runner-card .stat .v .u{
    font-size: 11px;
    font-weight: 400;
    opacity: 0.7;
    margin-left: 1px;
  }
  .runner-card .stat .l{
    font-family: 'DM Mono', monospace;
    font-size: 8px;
    letter-spacing: 0.12em;
    color: var(--wine-light);
    text-transform: uppercase;
    margin-top: 3px;
  }
  .runner-card.top .stat .l{ color: var(--cream); opacity: 0.75; }

  .runner-card .extras{
    grid-column: 1 / -1;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px dashed rgba(74,14,31,0.2);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .runner-card.top .extras{ border-top-color: rgba(201,169,97,0.3); }
  .runner-card .extras .x{
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .runner-card .extras .x .l{
    color: var(--wine-light);
    margin-bottom: 2px;
  }
  .runner-card.top .extras .x .l{ color: var(--cream); opacity: 0.65; }
  .runner-card .extras .x .v{
    font-family: 'Fraunces', serif;
    font-size: 14px;
    font-style: italic;
    color: var(--wine);
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
  }
  .runner-card.top .extras .x .v{ color: var(--gold-bright); }

  .awards-list{
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .award{
    background: var(--paper);
    border: 1px solid var(--wine);
    padding: 12px 14px;
    border-radius: 4px;
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 12px;
    align-items: center;
  }
  .award .icon{
    width: 38px;
    height: 38px;
    border: 1px solid var(--wine);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cream);
    font-size: 18px;
  }
  .award .title{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 600;
    font-size: 15px;
    color: var(--wine);
    line-height: 1.2;
  }
  .award .winner{
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.08em;
    color: var(--ink);
    margin-top: 3px;
    line-height: 1.4;
  }
  .award .winner b{ color: var(--rust); font-weight: 500; }

  .award.featured{
    background: var(--wine);
    color: var(--cream);
    border-color: var(--gold);
  }
  .award.featured .icon{
    background: var(--wine-deep);
    border-color: var(--gold);
  }
  .award.featured .title{ color: var(--gold-bright); }
  .award.featured .winner{ color: var(--cream); }
  .award.featured .winner b{ color: var(--gold-bright); }

  .award.shame{ border-left: 3px solid var(--rust); }
  .award.shame .icon{
    border-color: var(--rust);
    background: rgba(168,78,46,0.08);
  }
  .award.shame .title{ color: var(--rust); }

  .mini-board{
    background: var(--cream);
    border: 1px solid rgba(74,14,31,0.2);
    padding: 14px 16px;
    margin-bottom: 12px;
    border-radius: 4px;
  }
  .mini-board h3{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 16px;
    color: var(--wine);
    border-bottom: 1px dashed var(--wine);
    padding-bottom: 8px;
    margin-bottom: 4px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .mini-board h3 .meta{
    font-family: 'DM Mono', monospace;
    font-size: 8px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--wine-light);
    font-style: normal;
    font-weight: 400;
  }
  .mini-row{
    display: grid;
    grid-template-columns: 20px 1fr auto;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(74,14,31,0.08);
    align-items: center;
  }
  .mini-row:last-child{ border-bottom: none; }
  .mini-row .pos{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 14px;
    font-weight: 700;
    color: var(--wine-light);
  }
  .mini-row.top .pos{ color: var(--gold); }
  .mini-row .name{
    font-family: 'Fraunces', serif;
    font-size: 15px;
    color: var(--ink);
  }
  .mini-row .v{
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    color: var(--wine);
  }
  .mini-row .v.good{ color: var(--moss); }
  .mini-row .v.bad{ color: var(--rust); }

  .form-mini{
    display: inline-flex;
    gap: 3px;
    align-items: center;
  }
  .form-mini .d{
    display: inline-block;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: rgba(74,14,31,0.15);
    border: 1px solid rgba(74,14,31,0.3);
  }
  .form-mini .d.on{ background: var(--moss); border-color: var(--moss); }
  .form-mini .d.partial{ background: var(--gold); border-color: var(--gold); }
  .form-mini .d.skip{ background: var(--rust); border-color: var(--rust); }

  .plan-card{
    background: var(--wine);
    color: var(--cream);
    padding: 16px;
    margin-bottom: 16px;
    border-radius: 4px;
    position: relative;
  }
  .plan-card h3{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 18px;
    color: var(--gold-bright);
    margin-bottom: 6px;
  }
  .plan-card p{
    font-style: italic;
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.9;
    margin-bottom: 14px;
  }
  .plan-targets{
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid rgba(201,169,97,0.3);
  }
  .plan-targets .t{ text-align: center; }
  .plan-targets .t .v{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 22px;
    font-weight: 700;
    color: var(--gold-bright);
    line-height: 1;
  }
  .plan-targets .t .l{
    font-family: 'DM Mono', monospace;
    font-size: 8px;
    letter-spacing: 0.12em;
    color: var(--cream);
    opacity: 0.7;
    text-transform: uppercase;
    margin-top: 4px;
  }

  .phases-mobile{
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
  }
  .phase{
    background: var(--paper);
    border: 1px solid var(--wine);
    border-radius: 4px;
    padding: 12px 14px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 12px;
    align-items: center;
    position: relative;
  }
  .phase.now{
    background: var(--cream);
    border-width: 2px;
  }
  .phase .num{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 22px;
    font-weight: 800;
    color: var(--gold);
    line-height: 1;
  }
  .phase .body .name{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 600;
    font-size: 16px;
    color: var(--wine);
  }
  .phase .body .desc{
    font-size: 12px;
    color: var(--wine-light);
    margin-top: 2px;
    font-style: italic;
  }
  .phase .when{
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--wine-light);
    text-align: right;
  }
  .phase.now::before{
    content: 'NOW';
    position: absolute;
    top: -8px;
    right: 10px;
    background: var(--rust);
    color: var(--paper);
    font-family: 'DM Mono', monospace;
    font-size: 8px;
    letter-spacing: 0.2em;
    padding: 2px 6px;
    border-radius: 2px;
  }

  .week-block{
    background: var(--cream);
    border: 1px solid var(--wine);
    border-radius: 4px;
    padding: 14px;
  }
  .week-block h4{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 16px;
    color: var(--wine);
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px dashed var(--wine);
  }
  .workouts-mobile{
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .workout-row{
    display: grid;
    grid-template-columns: 38px 1fr auto;
    gap: 12px;
    padding: 10px 12px;
    align-items: center;
    background: var(--paper);
    border: 1px solid rgba(74,14,31,0.2);
    border-radius: 3px;
  }
  .workout-row.long{
    background: var(--wine);
    color: var(--cream);
    border-color: var(--gold);
  }
  .workout-row.rest{
    background: repeating-linear-gradient(45deg, var(--paper), var(--paper) 4px, var(--cream-warm) 4px, var(--cream-warm) 8px);
    opacity: 0.7;
  }
  .workout-row .day{
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--wine-light);
    font-weight: 500;
  }
  .workout-row.long .day{ color: var(--gold-bright); }
  .workout-row .type{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 600;
    font-size: 15px;
    color: var(--wine);
  }
  .workout-row.long .type{ color: var(--gold-bright); }
  .workout-row .v{
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: var(--ink);
  }
  .workout-row.long .v{ color: var(--cream); }

  .medoc-card{
    background: linear-gradient(135deg, var(--wine) 0%, var(--wine-deep) 100%);
    color: var(--cream);
    padding: 18px;
    margin-bottom: 16px;
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }
  .medoc-card::before{
    content: '🍷';
    position: absolute;
    font-size: 180px;
    right: -30px;
    top: -40px;
    opacity: 0.06;
    transform: rotate(-15deg);
  }
  .medoc-stats{
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 14px;
    position: relative;
    z-index: 1;
  }
  .medoc-stats .s{ text-align: center; }
  .medoc-stats .s .num{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 28px;
    font-weight: 800;
    color: var(--gold-bright);
    line-height: 1;
  }
  .medoc-stats .s .num small{ font-size: 14px; }
  .medoc-stats .s .l{
    font-family: 'DM Mono', monospace;
    font-size: 8px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--cream);
    opacity: 0.8;
    margin-top: 6px;
  }

  .costume-block{
    background: var(--paper);
    border: 1px solid var(--wine);
    border-radius: 4px;
    padding: 16px;
  }
  .costume-block h4{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: 17px;
    color: var(--wine);
  }
  .costume-block .sub{
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.12em;
    color: var(--wine-light);
    text-transform: uppercase;
    margin-top: 4px;
    margin-bottom: 14px;
  }
  .costume-block .sub b{ color: var(--rust); font-weight: 500; }
  .costume-grid{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .costume{
    border: 1px solid rgba(74,14,31,0.3);
    padding: 14px 10px;
    text-align: center;
    background: var(--cream);
    border-radius: 3px;
  }
  .costume .emoji{ font-size: 28px; }
  .costume .name{
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 600;
    font-size: 14px;
    color: var(--wine);
    margin-top: 6px;
  }
  .costume .votes{
    font-family: 'DM Mono', monospace;
    font-size: 8px;
    letter-spacing: 0.12em;
    color: var(--wine-light);
    margin-top: 4px;
  }
  .costume.leading{
    background: var(--wine);
    color: var(--cream);
    border-color: var(--gold);
  }
  .costume.leading .name{ color: var(--gold-bright); }
  .costume.leading .votes{ color: var(--cream); opacity: 0.8; }

  .footer{
    margin-top: 32px;
    padding: 20px 16px;
    border-top: 1px solid var(--wine);
    text-align: center;
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--wine-light);
  }
  .footer em{
    font-family: 'Fraunces', serif;
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
    color: var(--wine);
    font-size: 13px;
    display: block;
    margin-bottom: 8px;
  }

  @media (min-width: 500px){
    body{
      background: #1a0a0e;
      padding: 20px 0 60px;
    }
    body::before{ display: none; }
    .app{
      max-width: 390px;
      background: var(--paper);
      background-image:
        radial-gradient(ellipse at top, rgba(74,14,31,0.05), transparent 60%),
        radial-gradient(ellipse at bottom, rgba(201,169,97,0.08), transparent 60%);
      box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 0 8px #2a1a1e, 0 0 0 9px #444;
      border-radius: 36px;
      overflow: hidden;
      position: relative;
      min-height: 800px;
    }
    .app::after{
      content:'';
      position: absolute;
      top: 8px;
      left: 50%;
      transform: translateX(-50%);
      width: 110px;
      height: 24px;
      background: #000;
      border-radius: 14px;
      z-index: 100;
    }
    .header{ padding-top: 50px; }
  }
</style>
</head>
<body>
<div class="app">

  <header class="header">
    <div class="crest">
      <svg viewBox="0 0 40 40" fill="none">
        <!-- Wine glass: bowl + stem + base, held aloft -->
        <path d="M22 3 L34 3 L34 5 Q34 10 28 10 Q22 10 22 5 Z" fill="#4a0e1f"/>
        <line x1="28" y1="10" x2="28" y2="15" stroke="#4a0e1f" stroke-width="1.4" stroke-linecap="round"/>
        <line x1="24.5" y1="15" x2="31.5" y2="15" stroke="#4a0e1f" stroke-width="1.6" stroke-linecap="round"/>
        <!-- Runner: body on left, front arm raised to grasp the glass base -->
        <circle cx="12" cy="17" r="2.5" fill="#4a0e1f"/>
        <line x1="12" y1="19.5" x2="11" y2="27" stroke="#4a0e1f" stroke-width="1.7" stroke-linecap="round"/>
        <path d="M12 21 L8 22 L11 25" stroke="#4a0e1f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <path d="M13 20 L20 17 L26 15" stroke="#4a0e1f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <line x1="11" y1="27" x2="6" y2="35" stroke="#4a0e1f" stroke-width="1.7" stroke-linecap="round"/>
        <path d="M11 27 L17 30 L14 36" stroke="#4a0e1f" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
      </svg>
    </div>
    <h1>Le Marathon Du Médoc 26</h1>
    <div class="sub">13 amateurs surviving training · Médoc MMXXVI</div>
  </header>

  <div class="countdown-card">
    <div class="label">
      Days Until<br>Glory
      <span class="date">{{ race_date_label }}</span>
    </div>
    <div class="num">{{ days_until }}<small>days</small></div>
  </div>

  <div class="newsflash">
    <div class="nf-track">
      {% for item in news_flash %}
        <span><b>{{ item.label }}:</b> {{ item.text }}</span>
      {% endfor %}
      {% for item in news_flash %}
        <span><b>{{ item.label }}:</b> {{ item.text }}</span>
      {% endfor %}
    </div>
  </div>

  <nav class="tabs">
    <button class="tab active" data-tab="overview">Overview</button>
    <button class="tab" data-tab="standings">Standings</button>
    <button class="tab" data-tab="awards">Awards</button>
    <button class="tab" data-tab="stats">Stats</button>
    <button class="tab" data-tab="plan">Plan</button>
    <button class="tab" data-tab="medoc">Médoc</button>
  </nav>

  <main class="content">

    <!-- ============ OVERVIEW ============ -->
    <section class="panel active" data-panel="overview">

      <div class="squad-card">
        <div class="title">Squad Total</div>
        <div class="sub">Last 7 days</div>
        <div class="squad-grid">
          <div class="stat"><div class="v">{{ trailing_7d.total_km }}<span class="u">km</span></div><div class="l">Distance</div></div>
          <div class="stat"><div class="v">{{ trailing_7d.sessions }}</div><div class="l">Sessions</div></div>
          <div class="stat"><div class="v">{{ trailing_7d.combined_pace }}</div><div class="l">Avg pace</div></div>
        </div>
      </div>

      {% if groom_row %}
      <div class="big-card groom">
        <div class="lbl">Le Groom · rank #{{ groom_row.rank }}</div>
        <div class="v">{{ groom_row.name }}</div>
        <div class="meta">{{ groom_row.total_km }}km · {{ groom_row.streak }}-day streak · {{ groom_row.avg_pace }}/km</div>
      </div>
      {% endif %}

      <div class="stat-row">
        <div class="big-card">
          <div class="lbl">Group Predicted</div>
          <div class="v">{{ group.predicted }}<span class="unit">:00</span></div>
          <div class="delta {% if 'on for sub-4' in group.predicted_delta %}up{% else %}down{% endif %}">{{ group.predicted_delta }}</div>
        </div>
        {% set leader = runners[0] %}
        <div class="big-card">
          <div class="lbl">Top Performer</div>
          <div class="v">{{ leader.name.split()[0] }}</div>
          <div class="delta up">▲ {{ leader.predicted }} predicted</div>
        </div>
      </div>

      <div class="big-card">
        <div class="lbl">Squad Elevation · since 1 May</div>
        <div class="v">{{ group.elevation_m|comma }}<span class="unit">m</span></div>
        <div class="delta up">▲ Vertical metres climbed</div>
      </div>

      <div class="big-card">
        <div class="lbl">vs Last Week</div>
        <div class="v">
          {% if group.wow_pct is not none %}
            {{ group.wow_pct|signed_pct }}<span class="unit">%</span>
          {% else %}
            —
          {% endif %}
        </div>
        <div class="delta {% if group.wow_pct is not none and group.wow_pct > 0 %}up{% elif group.wow_pct is not none and group.wow_pct < 0 %}down{% endif %}">
          {% if group.wow_pct is not none and group.wow_pct > 0 %}▲ Squad picking up pace
          {% elif group.wow_pct is not none and group.wow_pct < 0 %}▼ Down vs last week
          {% else %}— First week of data
          {% endif %}
        </div>
      </div>
    </section>

    <!-- ============ STANDINGS ============ -->
    <section class="panel" data-panel="standings">
      <div class="sec-head">
        <span class="roman">I.</span>
        <h2>Standings</h2>
        <span class="meta">{{ current_phase.name }}</span>
      </div>

      {% for r in runners %}
      <div class="runner-card{% if r.rank == 1 %} top{% endif %}">
        <div class="rank">{{ r.rank_roman }}</div>
        <div class="info">
          <div class="name">{{ r.name }}
            {% if r.tag %}
              <span class="badge{% if r.is_brother %} rust{% endif %}">{{ r.tag }}</span>
            {% endif %}
          </div>
          <div class="meta">{{ r.meta }}</div>
        </div>
        <div class="stat">
          <div class="v">{{ r.predicted }}</div>
          <div class="l">{{ r.sub4 }}</div>
        </div>
        <div class="extras">
          <div class="x"><div class="l">This wk</div><div class="v">{{ r.week_km }}{% if r.week_km != "—" %}km{% endif %}</div></div>
          <div class="x"><div class="l">Total</div><div class="v">{{ r.total_km }}{% if r.total_km != "—" %}km{% endif %}</div></div>
          <div class="x"><div class="l">Longest</div><div class="v">{{ r.longest_km }}{% if r.longest_km != "—" %}km{% endif %}</div></div>
        </div>
      </div>
      {% endfor %}
    </section>

    <!-- ============ AWARDS ============ -->
    <section class="panel" data-panel="awards">
      <div class="sec-head">
        <span class="roman">II.</span>
        <h2>Hall of Fame &amp; Shame</h2>
        <span class="meta">Updated daily</span>
      </div>

      <div class="awards-list">
        {% for key in ['le_groom', 'sibling_rivalry', 'top_dog', 'biggest_shift', 'glow_up', 'la_flamme', 'laurore', 'the_sufferer', 'ghost', 'hangover_hero'] %}
          {% set a = awards[key] %}
          <div class="award{% if a.featured %} featured{% endif %}{% if a.shame %} shame{% endif %}">
            <div class="icon">{{ a.icon }}</div>
            <div>
              <div class="title">{{ a.title }}</div>
              <div class="winner">{{ a.detail|safe }}</div>
            </div>
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- ============ STATS ============ -->
    <section class="panel" data-panel="stats">
      <div class="sec-head">
        <span class="roman">III.</span>
        <h2>The Detail</h2>
        <span class="meta">Top 5</span>
      </div>

      <div class="mini-board">
        <h3>Longest Run <span class="meta">All-time PB</span></h3>
        {% for row in mini_boards.longest %}
          <div class="mini-row{% if loop.first %} top{% endif %}"><span class="pos">{{ ['i','ii','iii','iv','v'][loop.index0] }}</span><span class="name">{{ row.name }}</span><span class="v">{{ row.value }}</span></div>
        {% else %}
          <div class="mini-row"><span class="pos">—</span><span class="name">No long runs yet</span><span class="v">—</span></div>
        {% endfor %}
      </div>

      <div class="mini-board">
        <h3>Pace Improvement <span class="meta">Last 30d · /km</span></h3>
        {% for row in mini_boards.pace_imp %}
          <div class="mini-row{% if loop.first %} top{% endif %}"><span class="pos">{{ ['i','ii','iii','iv','v'][loop.index0] }}</span><span class="name">{{ row.name }}</span><span class="v {{ row.class|default('') }}">{{ row.value }}</span></div>
        {% else %}
          <div class="mini-row"><span class="pos">—</span><span class="name">Need 30+ days of data</span><span class="v">—</span></div>
        {% endfor %}
      </div>

      <div class="mini-board">
        <h3>Elevation <span class="meta">Since 1 May · m</span></h3>
        {% for row in mini_boards.elevation %}
          <div class="mini-row{% if loop.first %} top{% endif %}"><span class="pos">{{ ['i','ii','iii','iv','v'][loop.index0] }}</span><span class="name">{{ row.name }}</span><span class="v">{{ row.value }}</span></div>
        {% else %}
          <div class="mini-row"><span class="pos">—</span><span class="name">No elevation data</span><span class="v">—</span></div>
        {% endfor %}
      </div>

      <div class="mini-board">
        <h3>Avg Heart Rate <span class="meta">Lower = aerobic</span></h3>
        {% for row in mini_boards.hr %}
          <div class="mini-row{% if loop.first %} top{% endif %}"><span class="pos">{{ ['i','ii','iii','iv','v'][loop.index0] }}</span><span class="name">{{ row.name }}</span><span class="v {{ row.class|default('') }}">{{ row.value }}</span></div>
        {% else %}
          <div class="mini-row"><span class="pos">—</span><span class="name">No HR data yet</span><span class="v">—</span></div>
        {% endfor %}
      </div>

      <div class="mini-board">
        <h3>Form <span class="meta">Last 7d · most consistent</span></h3>
        {% for row in mini_boards.form %}
          <div class="mini-row"><span class="pos">{{ ['i','ii','iii','iv','v'][loop.index0] }}</span><span class="name">{{ row.name }}</span><span class="v"><span class="form-mini">{% for d in row.dots %}<i class="d {{ d }}"></i>{% endfor %}</span></span></div>
        {% else %}
          <div class="mini-row"><span class="pos">—</span><span class="name">Waiting on runs</span><span class="v">—</span></div>
        {% endfor %}
      </div>
    </section>

    <!-- ============ PLAN ============ -->
    <section class="panel" data-panel="plan">
      <div class="sec-head">
        <span class="roman">IV.</span>
        <h2>The Plan</h2>
        <span class="meta">18 weeks</span>
      </div>

      <div class="plan-card">
        <h3>Week {{ this_week.week_num }} of 18 — {{ this_week.phase }}</h3>
        <p>{{ this_week.focus }}</p>
        <div class="plan-targets">
          <div class="t"><div class="v">{{ this_week.target_km }}<span style="font-size:11px">km</span></div><div class="l">Target</div></div>
          <div class="t"><div class="v">{% if this_week.long_km == "RACE" %}42.2<span style="font-size:11px">km</span>{% else %}{{ this_week.long_km }}<span style="font-size:11px">km</span>{% endif %}</div><div class="l">{% if this_week.long_km == "RACE" %}Race{% else %}Long run{% endif %}</div></div>
          <div class="t"><div class="v">{{ plan_status.pct }}<span style="font-size:11px">%</span></div><div class="l">Squad done</div></div>
        </div>
      </div>

      <div class="big-card">
        <div class="lbl">Squad tracking · {{ plan_status.status }}</div>
        <div class="v">{{ plan_status.actual }}<span class="unit">/{{ plan_status.total_target }}km</span></div>
        <div class="delta {{ plan_status.tone }}">{{ plan_status.target_ratio_pct }}% of {{ plan_status.full_target }}km full plan ({{ plan_status.target_per_runner }}km × {{ plan_status.connected_n }})</div>
      </div>

      <div class="phases-mobile">
        {% for p in phases %}
          <div class="phase{% if p.is_current %} now{% endif %}">
            <div class="num">{{ p.num }}</div>
            <div class="body">
              <div class="name">{{ p.name }}</div>
              <div class="desc">{{ p.desc_short }}</div>
            </div>
            <div class="when">{{ p.when }}</div>
          </div>
        {% endfor %}
      </div>

      <div class="week-block">
        <h4>This week — pick 3–6 days</h4>
        <div class="workouts-mobile">
          {% for w in this_week.workouts %}
            <div class="workout-row{% if w.kind == 'long' %} long{% elif w.kind == 'rest' %} rest{% endif %}">
              <div class="day">{{ w.day }}</div>
              <div class="type">{{ w.type }}</div>
              <div class="v">{{ w.value }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>

    <!-- ============ MEDOC ============ -->
    <section class="panel" data-panel="medoc">
      <div class="sec-head">
        <span class="roman">V.</span>
        <h2>Le Médoc</h2>
        <span class="meta">For motivation</span>
      </div>

      <div class="medoc-card">
        <div class="medoc-stats">
          {% for f in medoc_facts %}
            <div class="s">
              <div class="num">{{ f.num }}{% if f.unit_small %}<small>{{ f.unit }}</small>{% endif %}</div>
              <div class="l">{{ f.lbl }}</div>
            </div>
          {% endfor %}
        </div>
      </div>
    </section>

  </main>

  <footer class="footer">
    <em>{{ footer_quote }}</em>
    <a href="https://www.strava.com" target="_blank" rel="noopener" aria-label="Powered by Strava" style="vertical-align:middle"><img src="assets/powered-by-strava-orange.svg" alt="Powered by Strava" style="height:12px;vertical-align:middle"></a> · {{ synced_at }}
  </footer>

</div>

<script>
  const tabs = document.querySelectorAll('.tab');
  const panels = document.querySelectorAll('.panel');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.tab;
      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      document.querySelector(`.panel[data-panel="${target}"]`).classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  });
</script>

</body>
</html>
